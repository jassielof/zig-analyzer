{
  "git.repositoryScanIgnoredFolders": [
    "references"
  ],
  "git.detectSubmodules": false,
  "better-todo-tree.filtering.excludeGlobs": [
    "**/node_modules/*/**",
    "**/references/**/*"
  ],
  "zigAnalyzer.serverPath": "${workspaceFolder}/zig-out/bin",
  "files.exclude": {
    "server": true
  },
  "zigAnalyzer.inlayHints.hideRedundantParamNames": true,
  "zigAnalyzer.inlayHints.hideRedundantParamNamesLastToken": true,
  "zigAnalyzer.unusedDeclDiagnostics": true,
  "zigAnalyzer.formatter.enable": true,
  "[zig]": {
    "editor.defaultFormatter": "jassielof.zig-analyzer"
  }
}
