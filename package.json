{
  "name": "zig-analyzer",
  "displayName": "Zig Analyzer",
  "publisher": "jassielof",
  "categories": [
    "Programming Languages"
  ],
  "bugs": {
    "url": "https://github.com/jassielof/zig-analyzer/issues"
  },
  "readme": "README.md",
  "version": "0.1.0",
  "description": "Zig Analyzer provides language server support for the Zig programming language.",
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/vscode",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "package": "node esbuild.config.js --production && vsce package --no-dependencies"
  },
  "qna": "https://github.com/jassielof/zig-analyzer/discussions",
  "repository": {
    "type": "git",
    "url": "https://github.com/jassielof/zig-analyzer",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "homepage": "https://github.com/jassielof/zig-analyzer",
  "galleryBanner": {
    "theme": "dark",
    "color": "#000000"
  },
  "icon": "assets/images/icon.png",
  "private": true,
  "activationEvents": [
    "onLanguage:zig",
    "workspaceContains:build.zig",
    "workspaceContains:build.zig.zon",
    "onLanguage:zon"
  ],
  "keywords": [
    "zig",
    "language-server",
    "lsp"
  ],
  "author": "Jassiel Ovando",
  "license": "MPL-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "zig",
        "extensions": [
          ".zig"
        ],
        "aliases": [
          "Zig",
          "zig"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "zon",
        "extensions": [
          ".zon"
        ],
        "aliases": [
          "ZON",
          "zon"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zig",
        "scopeName": "source.zig",
        "path": "./syntaxes/zig.tmLanguage.json"
      },
      {
        "language": "zon",
        "scopeName": "source.zon",
        "path": "./syntaxes/zon.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Zig Analyzer",
      "properties": {
        "zigAnalyzer.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to the zig-analyzer executable. If empty, the extension won't start the language server."
        },
        "zigAnalyzer.zigPath": {
          "type": "string",
          "default": "zig",
          "scope": "machine-overridable",
          "description": "Path to the zig executable, used by \"Zig Analyzer: Run Build Step\" to list and run build.zig steps."
        },
        "zigAnalyzer.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the zig-analyzer language server."
        },
        "zigAnalyzer.formatter.command": {
          "type": "string",
          "default": "zig",
          "scope": "machine-overridable",
          "markdownDescription": "The formatter executable to run for \"Format Document\". **Must behave like `zig fmt --stdin`**: read the entire document from stdin, write the fully formatted result to stdout, and exit with code 0 on success. A nonzero exit or any stderr output is treated as a formatting failure and the document is left unchanged.\n\nCombined with `#zigAnalyzer.formatter.args#` to build the full command line. Change this if the zero-config standard formatter (`zig fmt`) isn't what you want — e.g. a different Zig toolchain, or a wrapper script that also runs a linter — as long as it honors the stdin/stdout contract above."
        },
        "zigAnalyzer.formatter.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "fmt",
            "--stdin"
          ],
          "description": "Arguments passed to zigAnalyzer.formatter.command. The default runs the standard, zero-config `zig fmt --stdin`."
        }
      }
    },
    "commands": [
      {
        "command": "zigAnalyzer.restart",
        "title": "Zig Analyzer: Restart Language Server"
      },
      {
        "command": "zigAnalyzer.runBuildStep",
        "title": "Zig Analyzer: Run Build Step"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Executable paths (zigAnalyzer.serverPath, zigAnalyzer.zigPath, zigAnalyzer.formatter.command) are ignored in untrusted workspaces to prevent a workspace from silently configuring code execution.",
      "restrictedConfigurations": [
        "zigAnalyzer.serverPath",
        "zigAnalyzer.zigPath",
        "zigAnalyzer.formatter.command"
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0"
  }
}
