{
  "name": "zig-analyzer",
  "displayName": "Zig Analyzer",
  "publisher": "jassielof",
  "categories": [
    "Programming Languages"
  ],
  "bugs": {
    "url": "https://github.com/jassielof/zig-analyzer/issues"
  },
  "readme": "README.md",
  "version": "0.1.0",
  "description": "Zig Analyzer provides language server support for the Zig programming language.",
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "vsce package --no-dependencies"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jassielof/zig-analyzer",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "homepage": "https://github.com/jassielof/zig-analyzer",
  "galleryBanner": {
    "theme": "dark",
    "color": "#000000"
  },
  "icon": "assets/images/icon.png",
  "private": true,
  "activationEvents": [
    "onLanguage:zig",
    "onLanguage:zon"
  ],
  "keywords": [
    "zig",
    "language-server",
    "lsp"
  ],
  "author": "Jassiel Ovando",
  "license": "MPL-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "zig",
        "extensions": [
          ".zig",
          ".zon"
        ],
        "aliases": [
          "Zig",
          "zig",
          "ZON"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zig",
        "scopeName": "source.zig",
        "path": "./syntaxes/zig.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Zig Analyzer",
      "properties": {
        "zigAnalyzer.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the zig-analyzer executable. If empty, the extension won't start the language server."
        },
        "zigAnalyzer.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the zig-analyzer language server."
        }
      }
    },
    "commands": [
      {
        "command": "zigAnalyzer.restart",
        "title": "Zig Analyzer: Restart Language Server"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
