{
  "name": "zig-analyzer",
  "displayName": "Zig Analyzer",
  "publisher": "jassielof",
  "categories": [
    "Programming Languages"
  ],
  "readme": "README.adoc",
  "version": "0.1.0",
  "description": "Zig Analyzer provides language server support for the Zig programming language.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jassielof/zig-analyzer",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "keywords": [],
  "author": "Jassiel Ovando",
  "license": "MPL-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "zig",
        "extensions": [
          ".zig",
          ".zon"
        ],
        "aliases": [
          "Zig",
          "zig",
          "ZON"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zig",
        "scopeName": "source.zig",
        "path": "./syntaxes/zig.tmLanguage.json"
      }
    ]
  },
  "type": "module"
}
